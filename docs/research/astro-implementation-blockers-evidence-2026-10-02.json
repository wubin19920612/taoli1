    {
      "function": "zn",
      "utf8_byte_offset": 498649,
      "utf8_byte_length": 230,
      "sha256": "563c94896a4b7b480541411c9e819ed26096ea4cff88ebc828dd5eb980c625ab",
      "source": "function zn(e){switch(e){case\"T\":return 1e12;case\"B\":return 1e9;case\"M\":return 1e6;case\"K\":return 1e3;case\"1\":return 1;case\"1/K\":return 1/1e3;case\"1/M\":return 1/1e6;case\"1/B\":return 1/1e9;case\"1/T\":return 1/1e12;default:return 1}}"
    },
    {
      "function": "eT",
      "utf8_byte_offset": 498879,
      "utf8_byte_length": 204,
      "sha256": "fdd69d45ff10559bb56543ddc0c78a143c9c6cc1cc0bff14bc9ebe2099cacedc",
      "source": "function eT(e){switch(e){case\"T\":return\"1/T\";case\"B\":return\"1/B\";case\"M\":return\"1/M\";case\"K\":return\"1/K\";case\"1/K\":return\"K\";case\"1/M\":return\"M\";case\"1/B\":return\"B\";case\"1/T\":return\"T\";default:return\"1\"}}"
    },
    {
      "function": "In",
      "utf8_byte_offset": 499083,
      "utf8_byte_length": 79,
      "sha256": "a55d6f887849bf3252ae4ed99f2b8b5447438626f61d78ff61363cd3bd60b513",
      "source": "function In(e,t){const n=typeof e==\"string\"?parseFloat(e):e,o=zn(t);return n*o}"
    },
    {
      "function": "qi",
      "utf8_byte_offset": 505439,
      "utf8_byte_length": 74,
      "sha256": "e7df2c8769717b03d3c4377656d73013b20a3469f852d9d573691cfc4dda6114",
      "source": "function qi(e){return Number.isFinite(e)?Math.max(-em,Math.min(em,e)):NaN}"
    },
    {
      "function": "nn",
      "utf8_byte_offset": 505513,
      "utf8_byte_length": 128,
      "sha256": "7b102b61350e45f416ec39fb544502dc5cfcde0ea73762b8fb8d1dd901ccefd5",
      "source": "function nn(e){if(e==null||e===\"\")return null;const t=typeof e==\"string\"?parseFloat(e):e;return!Number.isFinite(t)||t<=0?null:t}"
    },
    {
      "function": "ao",
      "utf8_byte_offset": 505776,
      "utf8_byte_length": 115,
      "sha256": "37328e9ee16330b7d0d64802bf8b27f9eb7b4cdad6937be1efff36ab4279ecc2",
      "source": "function ao(e,t){if(!Number.isFinite(e)||!Number.isFinite(t))return NaN;const n=t+e;return n===0?NaN:2*(t-e)/n*100}"
    },
    {
      "function": "Lo",
      "utf8_byte_offset": 505891,
      "utf8_byte_length": 119,
      "sha256": "c7853ec34cfe5137ea0c4359b1b682601e5a8379eb7abd709b5bdf44c3c6dcff",
      "source": "function Lo(e,t){if(!Number.isFinite(e)||!Number.isFinite(t))return NaN;const n=e/100,o=2+n;return o===0?NaN:t*(2-n)/o}"
    },
    {
      "function": "tm",
      "utf8_byte_offset": 506010,
      "utf8_byte_length": 164,
      "sha256": "051790a2663fe3bca24fc9aaf3414b468b33120aaddad190fd1e3f1e6b598105",
      "source": "function tm(e,t,n,o){if(![e,t,n,o].every(Number.isFinite)||e<=0||t<=0||n<=0)return NaN;const r=ao(e*n,t),s=qi(r+o),a=Lo(s,t)/n;return Number.isFinite(a)&&a>0?a:NaN}"
    },
    {
      "function": "mT",
      "utf8_byte_offset": 506209,
      "utf8_byte_length": 275,
      "sha256": "7aaf05756de7862f15cb2ee3b968af7ccee0aab90db57bff23505295e870d68e",
      "source": "function mT(e,t,n,o,r=12){const s=a=>{if(a==null||a===\"\")return;const c=typeof a==\"number\"?a:parseFloat(a);if(!Number.isFinite(c))return a;const d=o?ao(c,n):Lo(qi(c),n);return Number.isFinite(d)?Number(d.toFixed(o?kn:r)):a};return{greaterPriceAlert:s(t),lessPriceAlert:s(e)}}"
    }
  ],
