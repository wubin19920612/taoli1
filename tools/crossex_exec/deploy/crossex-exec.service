[Unit]
Description=Small-notional CrossEx and Bitget IOC execution
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/wubin/taoli1
ExecStart=/usr/bin/python3 -m tools.crossex_exec run --env-file /home/ubuntu/wubin/crossex-exec/crossex-exec.env
Restart=on-failure
RestartSec=10
MemoryMax=80M
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/wubin/crossex-exec/var
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StandardOutput=journal
StandardError=journal
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
