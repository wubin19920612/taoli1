# Host nginx example. Replace certificate paths during deployment.
# Public edge: never trust client-supplied XFF or configure real-IP rewriting here.
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate /etc/nginx/tls/taoli1/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/taoli1/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
